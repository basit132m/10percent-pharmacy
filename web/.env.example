# Copy to web/.env and fill in from Firebase console:
# Project settings -> General -> Your apps -> Web app -> SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Region the Cloud Functions are deployed to (see functions/src/index.ts).
VITE_FIREBASE_FUNCTIONS_REGION=asia-south1

# Set to "true" to point the dashboard at the local Firebase emulators.
VITE_USE_EMULATORS=false
