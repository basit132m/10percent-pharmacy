# Copy to server/.env on the VPS and fill in. Never commit the real file.

# --- Firebase project ---------------------------------------------------
FIREBASE_PROJECT_ID=percent-pharmacy

# Path to the service account key JSON (Project settings -> Service accounts).
# Keep it outside the repo, readable only by the service user: chmod 600.
GOOGLE_APPLICATION_CREDENTIALS=/etc/pharmacy/service-account.json

# --- Firebase web config ------------------------------------------------
# From Project settings -> General -> Your apps -> Web app -> SDK setup.
# These are public values: they identify the project, they do not grant access.
FIREBASE_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Optional, sensible defaults are derived from the project id:
# FIREBASE_AUTH_DOMAIN=percent-pharmacy.firebaseapp.com
# FIREBASE_STORAGE_BUCKET=percent-pharmacy.appspot.com

# --- Server -------------------------------------------------------------
# Loopback only: the reverse proxy is what faces the internet.
HOST=127.0.0.1
PORT=8080

# Built dashboard. Defaults to ../web/dist relative to the compiled server.
# STATIC_DIR=/opt/pharmacy/web/dist
